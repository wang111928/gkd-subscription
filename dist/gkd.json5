  "checkUpdateUrl": "https://cdn.jsdelivr.net/gh/wang111928/gkd-subscription@main/dist/gkd.version.json5",
  "categories": [
    {
      "key": 0,
      "name": "开屏广告",
      "enable": true
    },
    {
      "key": 1,
      "name": "青少年模式",
      "enable": false
    },
    {
      "key": 2,
      "name": "更新提示",
      "enable": false
