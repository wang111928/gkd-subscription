            "https://i.gkd.li/i/25039297"
          ]
        },
        {
          "key": 1,
          "anyMatches": [
            "@View[text=null][clickable=true][visibleToUser=true][width<200&&height<200] +(1,2) TextView[index=parent.childCount.minus(1)] <n FrameLayout[childCount>2][text=null][desc=null] >(n+6) [text*=\"第三方应用\" || text*=\"扭动手机\" || text*=\"点击或上滑\" || text*=\"省钱好物\" || text*=\"扭一扭\"][visibleToUser=true]",
            "FrameLayout > FrameLayout[childCount>2][text=null][desc=null] > @View[text=null][clickable=true][visibleToUser=true][width<200&&height<200] +(1,2) TextView[index=parent.childCount.minus(1)][visibleToUser=true]"
          ],
          "snapshotUrls": [
            "https://i.gkd.li/i/19685971",
